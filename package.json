{
  "name": "ursprung-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter ursprung-web dev",
    "start": "bun --filter ursprung-web start",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "skills:update": "bunx skills update --project --yes",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "^5.9.3"
  }
}
