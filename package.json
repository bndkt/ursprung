{
  "name": "ursprung-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter ursprung-web dev",
    "start": "bun --filter ursprung-web start",
